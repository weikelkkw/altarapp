# ── Supabase ─────────────────────────────────────────────────────────────────
# Create a new project at https://supabase.com, then copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by API routes that need to bypass RLS (admin client).
# NEVER expose this to the browser. Only set it in Vercel as a server env var
# and in your local .env.local — not in any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Bible API ─────────────────────────────────────────────────────────────────
# Get a free key at https://scripture.api.bible
BIBLE_API_KEY=your-bible-api-key

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (Text-to-Speech) ───────────────────────────────────────────────
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=sk_...

# ── Mapbox (Bible Maps) ───────────────────────────────────────────────────────
# Get tokens at https://account.mapbox.com/access-tokens
# NEXT_PUBLIC_ prefix means this token is exposed in the browser — use a
# restricted token scoped to tile reads only.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...
# Server-only Mapbox token reserved for future server-side geocoding /
# protected style endpoints. Currently unused in code; set if planned.
MAPBOX_SECRET_TOKEN=sk.eyJ1...

# ── Spotify (optional — worship music integration) ────────────────────────────
# Register your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed to load /api/admin.
# Defense-in-depth: the admin route also requires a valid Supabase session.
ADMIN_EMAILS=you@example.com,other@example.com

# ── App URL ───────────────────────────────────────────────────────────────────
# Used for metadata / OG tags. In dev this can be http://localhost:3002
NEXT_PUBLIC_APP_URL=https://thealtar.app

# ── Upstash Redis (planned — distributed rate limiting) ──────────────────────
# Currently the rate limiter in src/lib/api/security.ts is in-memory per
# Lambda/Edge instance. Add these to swap in @upstash/ratelimit for prod.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
